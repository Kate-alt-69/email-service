# Email Service Configuration

# ========================================
# NODE.JS EXPRESS API
# ========================================
PORT=3001
HOST=localhost
NODE_ENV=development

# ========================================
# TLS/HTTPS CONFIGURATION (SECURE)
# ========================================
# Enable secure HTTPS connections
TLS_ENABLED=false
TLS_PORT=3443
TLS_CERT_PATH=./certs/server.crt
TLS_KEY_PATH=./certs/server.key
TLS_MIN_VERSION=TLSv1.2
TLS_REJECT_UNAUTHORIZED=true

# ========================================
# EMAIL BRANDING & CUSTOM DOMAINS
# ========================================
# Company information for email branding
COMPANY_NAME="Kastricks Emailing"
COMPANY_TAGLINE="Professional Email Service"
COMPANY_WEBSITE=https://httpsbuffcowland.in

# Custom domain for sending emails
CUSTOM_DOMAIN=httpsbuffcowland.in
CUSTOM_DOMAIN_FROM_EMAIL=official@httpsbuffcowland.in

# Logo/Icon configuration (supports .png, .jpg, .ico, .gif, .svg)
LOGO_PATH=./assets/logo.png

# Brand colors (hex format)
PRIMARY_COLOR=#007bff
ACCENT_COLOR=#0056b3

# ========================================
# OUTGOING MAIL (SMTP relay via Nodemailer)
# ========================================
EMAIL_PROVIDER=sendpulse
EMAIL_RELAY_PROVIDER=sendpulse

# Generic SMTP relay settings
SMTP_RELAY_HOST=
SMTP_RELAY_PORT=
SMTP_RELAY_SECURE=
SMTP_RELAY_IGNORE_TLS=
SMTP_RELAY_USER=
SMTP_RELAY_PASSWORD=

# SendPulse relay profile
SENDPULSE_SMTP_HOST=smtp-pulse.com
SENDPULSE_SMTP_PORT=2525
# Alternative ports: 465 (SSL) or 587 (TLS)
SENDPULSE_SMTP_SECURE=false
SENDPULSE_SMTP_IGNORE_TLS=false
SENDPULSE_SMTP_USER=
SENDPULSE_SMTP_PASSWORD=

# Email sender identity
EMAIL_FROM=noreply@httpsbuffcowland.in
EMAIL_FROM_NAME="BuffCowLand"
APP_URL=http://localhost:3000

# ========================================
# INCOMING MAIL (future / optional)
# ========================================
IMAP_HOST=localhost
IMAP_PORT=143
IMAP_SECURE=false
IMAP_USER=your-email@yourdomain.com
IMAP_PASSWORD=your-secure-password

# ========================================
# SMTP SERVER (local receive / relay testing)
# ========================================
SMTP_SERVER_PORT=25
SMTP_AUTH_REQUIRED=false
# Optional: whitelist domains for relay
SMTP_WHITELIST_DOMAINS=yourdomain.com,trusted.com
SMTP_USER=relay-user
SMTP_PASSWORD=relay-password

# ========================================
# STORAGE
# ========================================
EMAIL_STORAGE_DRIVER=file
EMAIL_DB_PATH=./data/email-service.db

# Optional PostgreSQL backend
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=email_service

# ========================================
# SERVICE COMMUNICATION
# ========================================
BOOTSTRAP_MANAGER_URL=http://localhost:9000
SERVICE_NAME=email-service
PROTOCOL_VERSION=1.0.0

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=info
LOG_FORMAT=pretty

# ========================================
# EMAIL RETENTION & CLEANUP
# ========================================
# Delete sent/received emails older than N days
EMAIL_RETENTION_DAYS=90

# ========================================
# OPTIONAL: Redis for Queues (BullMQ)
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================================
# CLOUDFLARE TUNNEL (Secure Public Access)
# ========================================
# Enable Cloudflare Tunnel for secure email service access
# Requires 'cloudflared' to be installed on the system
# Install: https://github.com/cloudflare/cloudflared/releases
CF_TUNNEL_ENABLED=false

# Cloudflare Tunnel Credentials
# Get your token from: https://dash.cloudflare.com/?to=/:account/home/tunnels
# This token is embedded in the binary at build time from environment variables
CF_TUNNEL_TOKEN=<your-cloudflare-tunnel-token-here>

# Your Cloudflare Account ID (hex value)
# Found at: https://dash.cloudflare.com/?to=/:account/home
CF_ACCOUNT_TAG=<your-account-id-here>

# Your registered domain (will route subdomains through tunnel)
# Example: httpsbuffcowland.in
CF_DOMAIN=httpsbuffcowland.in

# Tunnel Name (optional, for readability)
CF_TUNNEL_NAME=email-service-tunnel

# Public subdomains for routing through tunnel
# SMTP: smtp.{CF_DOMAIN} → localhost:SMTP_SERVER_PORT (smtp-server.ts)
# API:  api.{CF_DOMAIN}  → localhost:PORT (email-service.ts)
# Example with CF_DOMAIN=httpsbuffcowland.in:
#   - SMTP traffic: smtp.httpsbuffcowland.in → localhost:25
#   - API traffic:  api.httpsbuffcowland.in  → localhost:3001
#
# NOTE: When CF_TUNNEL_ENABLED=true, both services will connect to Cloudflare
#       Tunnel on startup and route traffic through the tunnel instead of
#       accepting direct connections.

