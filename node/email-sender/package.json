{
  "name": "email-sender-service",
  "version": "1.0.0",
  "description": "Email sending service using Nodemailer + Postfix",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node build/email-service.js",
    "start:smtp": "node build/smtp-server.js",
    "start:unified": "node build/unified-service.js",
    "start:both": "npm run start:smtp & npm run start",
    "dev": "ts-node src/email-service.ts",
    "dev:smtp": "ts-node src/smtp-server.ts",
    "dev:unified": "ts-node src/unified-service.ts",
    "watch": "tsc --watch",
    "test": "jest --passWithNoTests",
    "test:ipc": "jest tests/encrypted-ipc.test.ts",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2"
  },
  "keywords": [
    "email",
    "nodemailer",
    "postfix",
    "smtp"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bull": "^4.11.5",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "imapflow": "^1.2.18",
    "mailparser": "^3.9.6",
    "nodemailer": "^6.9.7",
    "pg": "^8.20.0",
    "redis": "^4.6.11",
    "smtp-server": "^3.18.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.11",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.19.37",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.20.0",
    "@types/smtp-server": "^3.5.12",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.27.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
}
